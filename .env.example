# ==========================================================
# AI Customer Support Assistant - Environment Configuration
# ==========================================================

# Optional: Groq API Key for LLM-powered response generation
# If left empty, the application runs in 100% offline Grounded Fallback Mode.
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default LLM Model ('llama-3.3-70b-versatile' or 'llama-3.1-8b-instant')
GROQ_MODEL=llama-3.3-70b-versatile
